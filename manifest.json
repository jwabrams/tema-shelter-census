{
  "name": "Shelter Census Summary",
  "short_name": "Shelter Summary",
  "description": "Displays shelter and linked census records for a given GlobalID from ArcGIS Online.",
  "version": "1.0.0",
  "homepage": "https://temahub.maps.arcgis.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwabrams/tema-shelter-census"
  },
  "author": "Tennessee Emergency Management Agency (TEMA)",
  "license": "MIT",
  "keywords": [
    "arcgis",
    "survey123",
    "shelter",
    "census",
    "tema",
    "emergency-management"
  ],
  "entry_point": "index.html",
  "parameters": {
    "id": {
      "type": "string",
      "required": true,
      "description": "GlobalID of the shelter record to display (e.g. ?id={GlobalID})"
    }
  },
  "layers": {
    "shelter": "https://services1.arcgis.com/kILp9lqGUeOhnDbI/arcgis/rest/services/service_570f1aad0c2641e7beac6dfca700747e/FeatureServer/0",
    "census": "https://services1.arcgis.com/kILp9lqGUeOhnDbI/ArcGIS/rest/services/Shelter_Census_View_Only/FeatureServer/0"
  },
  "auth": {
    "portals": [
      "https://temahub.maps.arcgis.com",
      "https://tnema.maps.arcgis.com"
    ],
    "fallback_login": "https://temahub.maps.arcgis.com/home/signin.html"
  }
}
